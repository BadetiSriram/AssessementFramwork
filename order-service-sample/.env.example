# Copy to .env and fill in real values. .env should be gitignored — never commit it.
# Camunda 8.9 SaaS cluster credentials (required by the base/saas profile).
CAMUNDA_CLIENT_ID=
CAMUNDA_CLIENT_SECRET=
CAMUNDA_CLUSTER_ID=
CAMUNDA_REGION=

# Postgres datasource (only needed for the default profile; the `local` profile uses H2).
# DB_URL=jdbc:postgresql://localhost:5432/order_service
# DB_USER=order_service
# DB_PASSWORD=
