{
  "type": "default",
  "id": "incident-closure-form",
  "schemaVersion": 18,
  "components": [
    {
      "type": "text",
      "id": "cl_intro",
      "text": "## Incident Closure\nReview the post-incident report and formally close the incident."
    },
    {
