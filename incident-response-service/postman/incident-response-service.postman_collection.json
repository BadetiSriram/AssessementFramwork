    {
      "name": "5 - Negative tests (validation & business errors)",
      "description": "RFC 7807 problem details from the framework's exception handler: bean validation gives 400 with fieldErrors, BusinessException gives 422 with an errorCode.",
      "item": [
        {
          "name": "Raise without title -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "const p = pm.response.json();",
                  "pm.test('reports the title field', () =>",
                  "  pm.expect((p.fieldErrors || []).map(f => f.field)).to.include('title'));",
                  "console.log(JSON.stringify(p.fieldErrors));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
