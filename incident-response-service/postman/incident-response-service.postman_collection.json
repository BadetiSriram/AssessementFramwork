                  "const items = pm.response.json().data || [];",
                  "console.log('Active tasks:', items.map(t => t.name + ' [' + t.userTaskKey + ']').join(', ') || '(none - either still automating, or the flow is past all human tasks)');",
                  "if (items[0]) pm.collectionVariables.set('taskKey', String(items[0].userTaskKey));",
                  "if (items[1]) pm.collectionVariables.set('taskKey2', String(items[1].userTaskKey));",
                  "pm.test('at most 2 concurrent tasks (parallel phase)', () => pm.expect(items.length).to.be.at.most(2));"
                ]
