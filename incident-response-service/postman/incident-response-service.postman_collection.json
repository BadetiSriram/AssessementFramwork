    {
      "name": "1 - Raise incident (classification scenarios)",
      "description": "title and source are required; attackConfirmed, assetCriticality (LOW/MEDIUM/HIGH/CRITICAL), dataExposed and recordCount are optional and steer the two DMNs. Leave them out and you get confirmed / HIGH / exposed / 25000, i.e. a P1 that needs regulatory notification.",
      "item": [
        {
          "name": "P1 - default triage signals (happy path)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set('incidentId', d.id);",
                  "pm.test('status RAISED', () => pm.expect(d.status).to.eql('RAISED'));",
                  "console.log('incidentId =', d.id, '| expect severity P1, regulatory notification REQUIRED');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Ransomware + data exfiltration on prod-db\",\n  \"source\": \"SIEM\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/incidents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents"
              ]
            },
            "description": "No signals, so the service defaults kick in (confirmed / HIGH / exposed / 25000) and the DMN says P1. Regulatory notification is required. Full response path with every human task."
          },
          "response": []
        },
        {
