    {
      "name": "2 - Incident state",
      "item": [
        {
          "name": "Get incident",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('severity is P1-P4 (or null before classification)', () =>",
                  "  pm.expect(d.severity === null || ['P1','P2','P3','P4'].includes(d.severity)).to.be.true);",
                  "pm.test('status is a known state', () =>",
                  "  pm.expect(['RAISED','TRIAGED','CLASSIFIED','RECOVERING','CLOSED','AUTO_CLOSED']).to.include(d.status));",
                  "console.log('status =', d.status, '| severity =', d.severity);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{incidentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidents",
                "{{incidentId}}"
              ]
            },
            "description": "Severity and status. RAISED -> TRIAGED -> CLASSIFIED -> RECOVERING -> CLOSED, or AUTO_CLOSED for a P4."
          },
          "response": []
        }
      ]
    },
