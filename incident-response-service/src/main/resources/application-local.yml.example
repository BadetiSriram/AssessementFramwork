# Copy to `application-local.yml` and fill in real values (that file is git-ignored).
# Run with:  mvn spring-boot:run "-Dspring-boot.run.profiles=local"
#
# PostgreSQL 17 must be running. Create a fresh database owned by the postgres superuser:
#   CREATE DATABASE incident_response OWNER postgres;   -- connect as postgres/postgres
# Flyway then creates the tables (V1 framework, V2 incidents, V3 incident_task_outcomes).
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/incident_response
    username: postgres
    password: postgres
  jpa:
    hibernate:
      ddl-auto: validate

# Camunda 8.9 SaaS cluster credentials — GET THESE FROM YOUR CAMUNDA CONSOLE. Never commit real values.
# The AI connector steps also need an OPENAI_API_TOKEN secret configured in Camunda Console.
camunda:
  client:
    mode: saas
    cloud:
      cluster-id: <YOUR_CLUSTER_ID>
      region: <YOUR_REGION>
    auth:
      client-id: <YOUR_CLIENT_ID>
      client-secret: <YOUR_CLIENT_SECRET>
