<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="incident-response-definitions"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!--
    Use Case 4 — Cyber Security Incident Response.

    start -> Triage (worker*) -> Classify (DMN -> severity) -> Record Classification (worker)
          -> P4? ── P4 → Auto Close (worker) -> end
                 ── else → parallel split:
                       A) Isolate (worker) [error ISOLATION_FAILED → commander] -> Containment Verification (SOC)
                       B) Collect Evidence (worker) -> Forensic Analysis (Forensics Lead)
                       C) Notify Stakeholders (worker)
                       D) AD-HOC response actions (commander activates block-ip / revoke-credentials / deploy-patch)
                     parallel join
          -> CISO Review (CISO) [non-interrupting SLA timer =slaDuration → escalate]
          -> Restore Services (worker) -> Integrity Verification (SOC)
          -> Regulatory Required? (DMN) ── yes → File Regulatory Notification (Legal)
                                                   [non-interrupting 72h timer → escalate to CISO]
                                        ── no  → (skip)
          -> Generate Post-Incident Report (worker*) -> Incident Closure (Incident Commander)
          -> Close Incident (worker) -> end

    (*Triage and Post-Incident Report are runnable placeholders for Camunda AI connector steps.)
    Timers here use short-ish ISO-8601 durations driven by severity (slaDuration) and the fixed
    72-hour regulatory deadline (PT72H). No BPMN DI is included — import into Web Modeler to lay it
    out for Operate/the demo.
  -->

  <bpmn:error id="Error_IsolationFailed" name="Isolation Failed" errorCode="ISOLATION_FAILED" />

  <bpmn:process id="incident-response" name="Cyber Security Incident Response" isExecutable="true">

    <bpmn:startEvent id="StartEvent_1" name="SIEM alert">
      <bpmn:outgoing>Flow_start_triage</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Triage" name="Triage Threat">
      <bpmn:extensionElements><zeebe:taskDefinition type="triage-threat" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_start_triage</bpmn:incoming>
      <bpmn:outgoing>Flow_triage_classify</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:businessRuleTask id="Task_Classify" name="Classify Incident">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="incident-classification" resultVariable="severity" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_triage_classify</bpmn:incoming>
      <bpmn:outgoing>Flow_classify_record</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:serviceTask id="Task_RecordClass" name="Record Classification">
      <bpmn:extensionElements><zeebe:taskDefinition type="record-classification" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_classify_record</bpmn:incoming>
      <bpmn:outgoing>Flow_record_p4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_P4" name="P4 / false positive?" default="Flow_p4_no">
      <bpmn:incoming>Flow_record_p4</bpmn:incoming>
      <bpmn:outgoing>Flow_p4_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_p4_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_AutoClose" name="Auto Close (P4)">
      <bpmn:extensionElements><zeebe:taskDefinition type="auto-close" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_p4_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_autoclose_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_AutoClosed" name="Auto-closed">
      <bpmn:incoming>Flow_autoclose_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:parallelGateway id="Gateway_Split" name="Response streams">
      <bpmn:incoming>Flow_p4_no</bpmn:incoming>
      <bpmn:outgoing>Flow_split_isolate</bpmn:outgoing>
      <bpmn:outgoing>Flow_split_evidence</bpmn:outgoing>
      <bpmn:outgoing>Flow_split_notify</bpmn:outgoing>
      <bpmn:outgoing>Flow_split_adhoc</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Branch A: Containment -->
    <bpmn:serviceTask id="Task_Isolate" name="Isolate Systems">
      <bpmn:extensionElements><zeebe:taskDefinition type="isolate-systems" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_split_isolate</bpmn:incoming>
      <bpmn:outgoing>Flow_isolate_verify</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:boundaryEvent id="Boundary_IsolationFailed" name="Isolation failed" attachedToRef="Task_Isolate">
      <bpmn:outgoing>Flow_isofail_handle</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_Isolation" errorRef="Error_IsolationFailed" />
    </bpmn:boundaryEvent>

    <bpmn:userTask id="Task_HandleIsoFail" name="Handle Isolation Failure">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="incident-commander" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_isofail_handle</bpmn:incoming>
      <bpmn:outgoing>Flow_handle_verify</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ContainVerify" name="Containment Verification">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="soc-analyst" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_isolate_verify</bpmn:incoming>
      <bpmn:incoming>Flow_handle_verify</bpmn:incoming>
      <bpmn:outgoing>Flow_verify_join</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Branch B: Forensics -->
    <bpmn:serviceTask id="Task_CollectEvidence" name="Collect Evidence">
      <bpmn:extensionElements><zeebe:taskDefinition type="collect-evidence" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_split_evidence</bpmn:incoming>
      <bpmn:outgoing>Flow_evidence_forensic</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_ForensicAnalysis" name="Forensic Analysis">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="forensics-lead" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_evidence_forensic</bpmn:incoming>
      <bpmn:outgoing>Flow_forensic_join</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Branch C: Notification -->
    <bpmn:serviceTask id="Task_Notify" name="Notify Stakeholders">
      <bpmn:extensionElements><zeebe:taskDefinition type="notify-stakeholders" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_split_notify</bpmn:incoming>
      <bpmn:outgoing>Flow_notify_join</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Branch D: Ad-hoc response actions (incident commander activates as findings emerge) -->
    <bpmn:adHocSubProcess id="AdHoc_ResponseActions" name="Response Actions (ad-hoc)" cancelRemainingInstances="false">
      <bpmn:extensionElements>
        <zeebe:adHoc activeElementsCollection="=responseActions" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_split_adhoc</bpmn:incoming>
      <bpmn:outgoing>Flow_adhoc_join</bpmn:outgoing>
      <bpmn:serviceTask id="Task_BlockIp" name="Block Malicious IP/Domain">
        <bpmn:extensionElements><zeebe:taskDefinition type="block-ip" /></bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_RevokeCredentials" name="Revoke Compromised Credentials">
        <bpmn:extensionElements><zeebe:taskDefinition type="revoke-credentials" /></bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_DeployPatch" name="Deploy Emergency Patch">
        <bpmn:extensionElements><zeebe:taskDefinition type="deploy-patch" /></bpmn:extensionElements>
      </bpmn:serviceTask>
    </bpmn:adHocSubProcess>

    <bpmn:parallelGateway id="Gateway_Join" name="Join">
      <bpmn:incoming>Flow_verify_join</bpmn:incoming>
      <bpmn:incoming>Flow_forensic_join</bpmn:incoming>
      <bpmn:incoming>Flow_notify_join</bpmn:incoming>
      <bpmn:incoming>Flow_adhoc_join</bpmn:incoming>
      <bpmn:outgoing>Flow_join_ciso</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_CisoReview" name="CISO Review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="ciso" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_join_ciso</bpmn:incoming>
      <bpmn:outgoing>Flow_ciso_restore</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Severity-based SLA timer on CISO review (non-interrupting): escalate if overdue -->
    <bpmn:boundaryEvent id="Boundary_CisoSla" name="SLA breach" cancelActivity="false" attachedToRef="Task_CisoReview">
      <bpmn:outgoing>Flow_sla_escalate</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_CisoSla">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=slaDuration</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="Task_EscalateSla" name="Escalate SLA Breach">
      <bpmn:extensionElements><zeebe:taskDefinition type="escalate" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_sla_escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_slaescalate_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_SlaEscalated" name="SLA escalated">
      <bpmn:incoming>Flow_slaescalate_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_Restore" name="Restore Services">
      <bpmn:extensionElements><zeebe:taskDefinition type="restore-services" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_ciso_restore</bpmn:incoming>
      <bpmn:outgoing>Flow_restore_integrity</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_IntegrityVerify" name="Integrity Verification">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="soc-analyst" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_restore_integrity</bpmn:incoming>
      <bpmn:outgoing>Flow_integrity_reg</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:businessRuleTask id="Task_RegDecision" name="Regulatory Notification Required?">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="regulatory-notification" resultVariable="regulatoryRequired" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_integrity_reg</bpmn:incoming>
      <bpmn:outgoing>Flow_reg_gw</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gateway_Reg" name="Regulatory required?" default="Flow_reg_no">
      <bpmn:incoming>Flow_reg_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_reg_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_reg_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_FileRegNotification" name="File Regulatory Notification">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="legal-compliance" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_reg_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_reg_merge</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 72-hour regulatory deadline (non-interrupting): escalate to the CISO if not filed in time -->
    <bpmn:boundaryEvent id="Boundary_Reg72h" name="72h deadline" cancelActivity="false" attachedToRef="Task_FileRegNotification">
      <bpmn:outgoing>Flow_reg72_escalate</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Reg72h">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT72H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="Task_EscalateCiso" name="Escalate to CISO (72h)">
      <bpmn:extensionElements><zeebe:taskDefinition type="escalate" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_reg72_escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_regescalate_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_RegEscalated" name="Deadline escalated">
      <bpmn:incoming>Flow_regescalate_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gateway_RegMerge">
      <bpmn:incoming>Flow_reg_no</bpmn:incoming>
      <bpmn:incoming>Flow_reg_merge</bpmn:incoming>
      <bpmn:outgoing>Flow_regmerge_report</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Report" name="Generate Post-Incident Report">
      <bpmn:extensionElements><zeebe:taskDefinition type="generate-report" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_regmerge_report</bpmn:incoming>
      <bpmn:outgoing>Flow_report_closure</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_Closure" name="Incident Closure">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="incident-commander" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_report_closure</bpmn:incoming>
      <bpmn:outgoing>Flow_closure_close</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_Close" name="Close Incident">
      <bpmn:extensionElements><zeebe:taskDefinition type="close-incident" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_closure_close</bpmn:incoming>
      <bpmn:outgoing>Flow_close_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Closed" name="Closed">
      <bpmn:incoming>Flow_close_end</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_start_triage" sourceRef="StartEvent_1" targetRef="Task_Triage" />
    <bpmn:sequenceFlow id="Flow_triage_classify" sourceRef="Task_Triage" targetRef="Task_Classify" />
    <bpmn:sequenceFlow id="Flow_classify_record" sourceRef="Task_Classify" targetRef="Task_RecordClass" />
    <bpmn:sequenceFlow id="Flow_record_p4" sourceRef="Task_RecordClass" targetRef="Gateway_P4" />
    <bpmn:sequenceFlow id="Flow_p4_yes" name="P4" sourceRef="Gateway_P4" targetRef="Task_AutoClose">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=severity = "P4"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_autoclose_end" sourceRef="Task_AutoClose" targetRef="End_AutoClosed" />
    <bpmn:sequenceFlow id="Flow_p4_no" name="P1-P3" sourceRef="Gateway_P4" targetRef="Gateway_Split" />
    <bpmn:sequenceFlow id="Flow_split_isolate" sourceRef="Gateway_Split" targetRef="Task_Isolate" />
    <bpmn:sequenceFlow id="Flow_split_evidence" sourceRef="Gateway_Split" targetRef="Task_CollectEvidence" />
    <bpmn:sequenceFlow id="Flow_split_notify" sourceRef="Gateway_Split" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="Flow_split_adhoc" sourceRef="Gateway_Split" targetRef="AdHoc_ResponseActions" />
    <bpmn:sequenceFlow id="Flow_isolate_verify" sourceRef="Task_Isolate" targetRef="Task_ContainVerify" />
    <bpmn:sequenceFlow id="Flow_isofail_handle" sourceRef="Boundary_IsolationFailed" targetRef="Task_HandleIsoFail" />
    <bpmn:sequenceFlow id="Flow_handle_verify" sourceRef="Task_HandleIsoFail" targetRef="Task_ContainVerify" />
    <bpmn:sequenceFlow id="Flow_verify_join" sourceRef="Task_ContainVerify" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_evidence_forensic" sourceRef="Task_CollectEvidence" targetRef="Task_ForensicAnalysis" />
    <bpmn:sequenceFlow id="Flow_forensic_join" sourceRef="Task_ForensicAnalysis" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_notify_join" sourceRef="Task_Notify" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_adhoc_join" sourceRef="AdHoc_ResponseActions" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_join_ciso" sourceRef="Gateway_Join" targetRef="Task_CisoReview" />
    <bpmn:sequenceFlow id="Flow_sla_escalate" sourceRef="Boundary_CisoSla" targetRef="Task_EscalateSla" />
    <bpmn:sequenceFlow id="Flow_slaescalate_end" sourceRef="Task_EscalateSla" targetRef="End_SlaEscalated" />
    <bpmn:sequenceFlow id="Flow_ciso_restore" sourceRef="Task_CisoReview" targetRef="Task_Restore" />
    <bpmn:sequenceFlow id="Flow_restore_integrity" sourceRef="Task_Restore" targetRef="Task_IntegrityVerify" />
    <bpmn:sequenceFlow id="Flow_integrity_reg" sourceRef="Task_IntegrityVerify" targetRef="Task_RegDecision" />
    <bpmn:sequenceFlow id="Flow_reg_gw" sourceRef="Task_RegDecision" targetRef="Gateway_Reg" />
    <bpmn:sequenceFlow id="Flow_reg_yes" name="required" sourceRef="Gateway_Reg" targetRef="Task_FileRegNotification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=regulatoryRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_reg_no" name="not required" sourceRef="Gateway_Reg" targetRef="Gateway_RegMerge" />
    <bpmn:sequenceFlow id="Flow_reg_merge" sourceRef="Task_FileRegNotification" targetRef="Gateway_RegMerge" />
    <bpmn:sequenceFlow id="Flow_reg72_escalate" sourceRef="Boundary_Reg72h" targetRef="Task_EscalateCiso" />
    <bpmn:sequenceFlow id="Flow_regescalate_end" sourceRef="Task_EscalateCiso" targetRef="End_RegEscalated" />
    <bpmn:sequenceFlow id="Flow_regmerge_report" sourceRef="Gateway_RegMerge" targetRef="Task_Report" />
    <bpmn:sequenceFlow id="Flow_report_closure" sourceRef="Task_Report" targetRef="Task_Closure" />
    <bpmn:sequenceFlow id="Flow_closure_close" sourceRef="Task_Closure" targetRef="Task_Close" />
    <bpmn:sequenceFlow id="Flow_close_end" sourceRef="Task_Close" targetRef="End_Closed" />

  </bpmn:process>
</bpmn:definitions>
