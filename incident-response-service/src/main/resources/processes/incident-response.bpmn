    <bpmn:sequenceFlow id="Flow_regmerge_reportai" sourceRef="Gateway_RegMerge" targetRef="Task_ReportAI" />
    <bpmn:sequenceFlow id="Flow_reportai_closure" sourceRef="Task_ReportAI" targetRef="Task_Closure" />
