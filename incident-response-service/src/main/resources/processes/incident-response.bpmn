<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="incident-response-definitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="aeb6083" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:error id="Error_IsolationFailed" name="Isolation Failed" errorCode="ISOLATION_FAILED" />
  <bpmn:error id="Error_AiFailed" name="AI Step Failed" errorCode="AI_STEP_FAILED" />
  <bpmn:collaboration id="Collaboration_incident-response">
    <bpmn:participant id="Participant_Soc" name="Security Operations - Cyber Incident Response" processRef="incident-response" />
  </bpmn:collaboration>
  <bpmn:process id="incident-response" name="Cyber Security Incident Response" isExecutable="true">
    <bpmn:laneSet id="LaneSet_incident-response">
      <bpmn:lane id="Lane_Automation" name="Automated Response Platform (workers / DMN / AI)">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TriageAI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Triage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Classify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordClass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_P4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoClose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AutoClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AdHoc_ResponseActions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EscalateSla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SlaEscalated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RegMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EscalateCiso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReportAI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_ReportAiFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RegEscalated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SocAnalyst" name="SOC Analyst">
        <bpmn:flowNodeRef>SubProcess_Containment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_Recovery</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ForensicsLead" name="Forensics Lead">
        <bpmn:flowNodeRef>SubProcess_Forensics</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ciso" name="CISO">
        <bpmn:flowNodeRef>Task_CisoReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_CisoSla</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Legal" name="Legal &#38; Compliance">
        <bpmn:flowNodeRef>Task_FileRegNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Reg72h</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IncidentCommander" name="Incident Commander">
        <bpmn:flowNodeRef>Task_Closure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="SIEM alert">
      <bpmn:outgoing>Flow_start_triageai</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_TriageAI" name="AI Threat Triage" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.v1" zeebe:modelerTemplateVersion="7" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="openai" target="provider.type" />
          <zeebe:input source="{{secrets.OPENAI_API_TOKEN}}" target="provider.openai.authentication.apiKey" />
          <zeebe:input source="gpt-4o-mini" target="provider.openai.model.model" />
          <zeebe:input source="=&#34;You are a SOC threat-triage assistant. Given a security alert, produce a concise triage summary (3-4 sentences): enrichment, likely IOCs, and attack-pattern match.&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=&#34;Triage this alert. Title: &#34; + title + &#34;. Source: &#34; + source" target="data.userPrompt.prompt" />
          <zeebe:input source="=triageAgent.context" target="data.context" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="20" target="data.memory.contextWindowSize" />
          <zeebe:input source="5" target="data.limits.maxModelCalls" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=false" target="data.response.includeAssistantMessage" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="7" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.v1" />
          <zeebe:header key="resultVariable" value="triageAgent" />
          <zeebe:header key="resultExpression" value="={triageReport: response.responseText}" />
          <zeebe:header key="errorExpression" value="=if error != null then bpmnError(&#34;AI_STEP_FAILED&#34;, &#34;AI triage step failed&#34;) else null" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_triageai</bpmn:incoming>
      <bpmn:outgoing>Flow_triageai_worker</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_TriageAiFailed" name="AI failed" attachedToRef="Task_TriageAI">
      <bpmn:outgoing>Flow_triageaifail_worker</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_TriageAi" errorRef="Error_AiFailed" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_Triage" name="Record Triage / Set DMN Inputs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="triage-threat" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_triageai_worker</bpmn:incoming>
      <bpmn:incoming>Flow_triageaifail_worker</bpmn:incoming>
      <bpmn:outgoing>Flow_triage_classify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_Classify" name="Classify Incident">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="incident-classification" resultVariable="severity" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_triage_classify</bpmn:incoming>
      <bpmn:outgoing>Flow_classify_record</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Task_RecordClass" name="Record Classification">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-classification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_classify_record</bpmn:incoming>
      <bpmn:outgoing>Flow_record_p4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_P4" name="P4 / false positive?" default="Flow_p4_no">
      <bpmn:incoming>Flow_record_p4</bpmn:incoming>
      <bpmn:outgoing>Flow_p4_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_p4_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AutoClose" name="Auto Close (P4)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="auto-close" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_p4_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_autoclose_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_AutoClosed" name="Auto-closed">
      <bpmn:incoming>Flow_autoclose_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Gateway_Split" name="Response streams">
      <bpmn:incoming>Flow_p4_no</bpmn:incoming>
      <bpmn:outgoing>Flow_split_containment</bpmn:outgoing>
      <bpmn:outgoing>Flow_split_forensics</bpmn:outgoing>
      <bpmn:outgoing>Flow_split_notify</bpmn:outgoing>
      <bpmn:outgoing>Flow_split_adhoc</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:subProcess id="SubProcess_Containment" name="Containment">
      <bpmn:incoming>Flow_split_containment</bpmn:incoming>
      <bpmn:outgoing>Flow_containment_join</bpmn:outgoing>
      <bpmn:startEvent id="Cont_Start">
        <bpmn:outgoing>Flow_cont_start_isolate</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_Isolate" name="Isolate Systems">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="isolate-systems" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_cont_start_isolate</bpmn:incoming>
        <bpmn:outgoing>Flow_cont_isolate_verify</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="Boundary_IsolationFailed" name="Isolation failed" attachedToRef="Task_Isolate">
        <bpmn:outgoing>Flow_cont_isofail_handle</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorDef_Isolation" errorRef="Error_IsolationFailed" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="Task_HandleIsoFail" name="Handle Isolation Failure">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="handle-isolation-failure-form" />
          <zeebe:assignmentDefinition candidateGroups="incident-commander" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_cont_isofail_handle</bpmn:incoming>
        <bpmn:outgoing>Flow_cont_handle_verify</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Task_ContainVerify" name="Containment Verification">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="containment-verification-form" />
          <zeebe:assignmentDefinition candidateGroups="soc-analyst" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_cont_isolate_verify</bpmn:incoming>
        <bpmn:incoming>Flow_cont_handle_verify</bpmn:incoming>
        <bpmn:outgoing>Flow_cont_verify_end</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="Cont_End">
        <bpmn:incoming>Flow_cont_verify_end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_cont_start_isolate" sourceRef="Cont_Start" targetRef="Task_Isolate" />
      <bpmn:sequenceFlow id="Flow_cont_isolate_verify" sourceRef="Task_Isolate" targetRef="Task_ContainVerify" />
      <bpmn:sequenceFlow id="Flow_cont_isofail_handle" sourceRef="Boundary_IsolationFailed" targetRef="Task_HandleIsoFail" />
      <bpmn:sequenceFlow id="Flow_cont_handle_verify" sourceRef="Task_HandleIsoFail" targetRef="Task_ContainVerify" />
      <bpmn:sequenceFlow id="Flow_cont_verify_end" sourceRef="Task_ContainVerify" targetRef="Cont_End" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SubProcess_Forensics" name="Forensics">
      <bpmn:incoming>Flow_split_forensics</bpmn:incoming>
      <bpmn:outgoing>Flow_forensics_join</bpmn:outgoing>
      <bpmn:startEvent id="For_Start">
        <bpmn:outgoing>Flow_for_start_evidence</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_CollectEvidence" name="Collect Evidence">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="collect-evidence" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_for_start_evidence</bpmn:incoming>
        <bpmn:outgoing>Flow_for_evidence_analysis</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="Task_ForensicAnalysis" name="Forensic Analysis">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="forensic-analysis-form" />
          <zeebe:assignmentDefinition candidateGroups="forensics-lead" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_for_evidence_analysis</bpmn:incoming>
        <bpmn:outgoing>Flow_for_analysis_end</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="For_End">
        <bpmn:incoming>Flow_for_analysis_end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_for_start_evidence" sourceRef="For_Start" targetRef="Task_CollectEvidence" />
      <bpmn:sequenceFlow id="Flow_for_evidence_analysis" sourceRef="Task_CollectEvidence" targetRef="Task_ForensicAnalysis" />
      <bpmn:sequenceFlow id="Flow_for_analysis_end" sourceRef="Task_ForensicAnalysis" targetRef="For_End" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="Task_Notify" name="Notify Stakeholders">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-stakeholders" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_split_notify</bpmn:incoming>
      <bpmn:outgoing>Flow_notify_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:adHocSubProcess id="AdHoc_ResponseActions" name="Response Actions (ad-hoc)" cancelRemainingInstances="false">
      <bpmn:extensionElements>
        <zeebe:adHoc activeElementsCollection="=responseActions" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_split_adhoc</bpmn:incoming>
      <bpmn:outgoing>Flow_adhoc_join</bpmn:outgoing>
      <bpmn:serviceTask id="Task_BlockIp" name="Block Malicious IP/Domain">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="block-ip" />
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_RevokeCredentials" name="Revoke Compromised Credentials">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="revoke-credentials" />
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_DeployPatch" name="Deploy Emergency Patch">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="deploy-patch" />
        </bpmn:extensionElements>
      </bpmn:serviceTask>
    </bpmn:adHocSubProcess>
    <bpmn:parallelGateway id="Gateway_Join" name="Join">
      <bpmn:incoming>Flow_containment_join</bpmn:incoming>
      <bpmn:incoming>Flow_forensics_join</bpmn:incoming>
      <bpmn:incoming>Flow_notify_join</bpmn:incoming>
      <bpmn:incoming>Flow_adhoc_join</bpmn:incoming>
      <bpmn:outgoing>Flow_join_ciso</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_CisoReview" name="CISO Review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="ciso-review-form" />
        <zeebe:assignmentDefinition candidateGroups="ciso" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_join_ciso</bpmn:incoming>
      <bpmn:outgoing>Flow_ciso_recovery</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_EscalateSla" name="Escalate SLA Breach">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="escalate" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_sla_escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_slaescalate_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_SlaEscalated" name="SLA escalated">
      <bpmn:incoming>Flow_slaescalate_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess_Recovery" name="Recovery">
      <bpmn:incoming>Flow_ciso_recovery</bpmn:incoming>
      <bpmn:outgoing>Flow_recovery_reg</bpmn:outgoing>
      <bpmn:startEvent id="Rec_Start">
        <bpmn:outgoing>Flow_rec_start_restore</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_Restore" name="Restore Services">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="restore-services" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_rec_start_restore</bpmn:incoming>
        <bpmn:outgoing>Flow_rec_restore_integrity</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="Task_IntegrityVerify" name="Integrity Verification">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="integrity-verification-form" />
          <zeebe:assignmentDefinition candidateGroups="soc-analyst" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_rec_restore_integrity</bpmn:incoming>
        <bpmn:outgoing>Flow_rec_integrity_end</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="Rec_End">
        <bpmn:incoming>Flow_rec_integrity_end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_rec_start_restore" sourceRef="Rec_Start" targetRef="Task_Restore" />
      <bpmn:sequenceFlow id="Flow_rec_restore_integrity" sourceRef="Task_Restore" targetRef="Task_IntegrityVerify" />
      <bpmn:sequenceFlow id="Flow_rec_integrity_end" sourceRef="Task_IntegrityVerify" targetRef="Rec_End" />
    </bpmn:subProcess>
    <bpmn:businessRuleTask id="Task_RegDecision" name="Regulatory Notification Required?">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="regulatory-notification" resultVariable="regulatoryRequired" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_recovery_reg</bpmn:incoming>
      <bpmn:outgoing>Flow_reg_gw</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Reg" name="Regulatory required?" default="Flow_reg_no">
      <bpmn:incoming>Flow_reg_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_reg_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_reg_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_FileRegNotification" name="File Regulatory Notification">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="file-regulatory-notification-form" />
        <zeebe:assignmentDefinition candidateGroups="legal-compliance" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_reg_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_reg_merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_EscalateCiso" name="Escalate to CISO (72h)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="escalate" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_reg72_escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_regescalate_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_RegMerge">
      <bpmn:incoming>Flow_reg_no</bpmn:incoming>
      <bpmn:incoming>Flow_reg_merge</bpmn:incoming>
      <bpmn:outgoing>Flow_regmerge_reportai</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ReportAI" name="AI Post-Incident Report" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.v1" zeebe:modelerTemplateVersion="7" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="openai" target="provider.type" />
          <zeebe:input source="{{secrets.OPENAI_API_TOKEN}}" target="provider.openai.authentication.apiKey" />
          <zeebe:input source="gpt-4o-mini" target="provider.openai.model.model" />
          <zeebe:input source="=&#34;You are an incident-response analyst. Write a concise post-incident report with sections: timeline, root cause, impact, and lessons learned.&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=&#34;Incident: &#34; + title + &#34;, severity &#34; + severity + &#34;. Triage findings: &#34; + triageReport" target="data.userPrompt.prompt" />
          <zeebe:input source="=reportAgent.context" target="data.context" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="20" target="data.memory.contextWindowSize" />
          <zeebe:input source="5" target="data.limits.maxModelCalls" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=false" target="data.response.includeAssistantMessage" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="7" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.v1" />
          <zeebe:header key="resultVariable" value="reportAgent" />
          <zeebe:header key="resultExpression" value="={postIncidentReport: response.responseText}" />
          <zeebe:header key="errorExpression" value="=if error != null then bpmnError(&#34;AI_STEP_FAILED&#34;, &#34;AI report step failed&#34;) else null" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_regmerge_reportai</bpmn:incoming>
      <bpmn:outgoing>Flow_reportai_closure</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Closure" name="Incident Closure">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="incident-closure-form" />
        <zeebe:assignmentDefinition candidateGroups="incident-commander" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_reportai_closure</bpmn:incoming>
      <bpmn:incoming>Flow_reportfallback_closure</bpmn:incoming>
      <bpmn:outgoing>Flow_closure_close</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Close" name="Close Incident">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="close-incident" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_closure_close</bpmn:incoming>
      <bpmn:outgoing>Flow_close_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Closed" name="Closed">
      <bpmn:incoming>Flow_close_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_triageai" sourceRef="StartEvent_1" targetRef="Task_TriageAI" />
