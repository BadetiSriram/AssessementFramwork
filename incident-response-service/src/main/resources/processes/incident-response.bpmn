      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_RegEscalated" name="Deadline escalated">
      <bpmn:incoming>Flow_regescalate_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_CisoSla" name="SLA breach" cancelActivity="false" attachedToRef="Task_CisoReview">
