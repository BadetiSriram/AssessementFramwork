<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="incident-response-definitions"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!--
    Use Case 4 — Cyber Security Incident Response (first executable version).

    start -> Triage (worker; AI-connector placeholder)
          -> Classify (DMN business rule task -> severity)
          -> Record Classification (worker)
          -> P4? gateway  ── P4 ──> Auto Close (worker) -> end
                          ── else ─> parallel split:
                                       A) Isolate (worker) [error ISOLATION_FAILED -> commander] -> Containment Verification (SOC)
                                       B) Collect Evidence (worker) -> Forensic Analysis (Forensics Lead)
                                       C) Notify Stakeholders (worker)
                                     parallel join
          -> CISO Review (CISO) -> Restore Services (worker) -> Integrity Verification (SOC)
          -> Generate Post-Incident Report (worker; AI-connector placeholder)
          -> Incident Closure (Incident Commander) -> Close Incident (worker) -> end

    NOTE (next iterations, best done in Web Modeler): wrap Containment/Forensics/Recovery in
    embedded sub-processes; add the ad-hoc response-actions sub-process (block-ip / revoke-
    credentials / deploy-patch); add the 72h regulatory timer + severity SLA timers; and the
    Regulatory-Notification DMN. The workers/DMN for these already exist in the codebase.
  -->

  <bpmn:error id="Error_IsolationFailed" name="Isolation Failed" errorCode="ISOLATION_FAILED" />

  <bpmn:process id="incident-response" name="Cyber Security Incident Response" isExecutable="true">

    <bpmn:startEvent id="StartEvent_1" name="SIEM alert">
      <bpmn:outgoing>Flow_start_triage</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Triage" name="Triage Threat">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="triage-threat" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_triage</bpmn:incoming>
      <bpmn:outgoing>Flow_triage_classify</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:businessRuleTask id="Task_Classify" name="Classify Incident">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="incident-classification" resultVariable="severity" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_triage_classify</bpmn:incoming>
      <bpmn:outgoing>Flow_classify_record</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:serviceTask id="Task_RecordClass" name="Record Classification">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-classification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_classify_record</bpmn:incoming>
      <bpmn:outgoing>Flow_record_p4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_P4" name="P4 / false positive?" default="Flow_p4_no">
      <bpmn:incoming>Flow_record_p4</bpmn:incoming>
      <bpmn:outgoing>Flow_p4_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_p4_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_AutoClose" name="Auto Close (P4)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="auto-close" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_p4_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_autoclose_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_AutoClosed" name="Auto-closed">
      <bpmn:incoming>Flow_autoclose_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:parallelGateway id="Gateway_Split" name="Response streams">
      <bpmn:incoming>Flow_p4_no</bpmn:incoming>
      <bpmn:outgoing>Flow_split_isolate</bpmn:outgoing>
      <bpmn:outgoing>Flow_split_evidence</bpmn:outgoing>
      <bpmn:outgoing>Flow_split_notify</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Branch A: Containment -->
    <bpmn:serviceTask id="Task_Isolate" name="Isolate Systems">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="isolate-systems" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_split_isolate</bpmn:incoming>
      <bpmn:outgoing>Flow_isolate_verify</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:boundaryEvent id="Boundary_IsolationFailed" name="Isolation failed" attachedToRef="Task_Isolate">
      <bpmn:outgoing>Flow_isofail_handle</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_Isolation" errorRef="Error_IsolationFailed" />
    </bpmn:boundaryEvent>

    <bpmn:userTask id="Task_HandleIsoFail" name="Handle Isolation Failure">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="incident-commander" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_isofail_handle</bpmn:incoming>
      <bpmn:outgoing>Flow_handle_verify</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ContainVerify" name="Containment Verification">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="soc-analyst" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_isolate_verify</bpmn:incoming>
      <bpmn:incoming>Flow_handle_verify</bpmn:incoming>
      <bpmn:outgoing>Flow_verify_join</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Branch B: Forensics -->
    <bpmn:serviceTask id="Task_CollectEvidence" name="Collect Evidence">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="collect-evidence" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_split_evidence</bpmn:incoming>
      <bpmn:outgoing>Flow_evidence_forensic</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_ForensicAnalysis" name="Forensic Analysis">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="forensics-lead" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_evidence_forensic</bpmn:incoming>
      <bpmn:outgoing>Flow_forensic_join</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Branch C: Notification -->
    <bpmn:serviceTask id="Task_Notify" name="Notify Stakeholders">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-stakeholders" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_split_notify</bpmn:incoming>
      <bpmn:outgoing>Flow_notify_join</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:parallelGateway id="Gateway_Join" name="Join">
      <bpmn:incoming>Flow_verify_join</bpmn:incoming>
      <bpmn:incoming>Flow_forensic_join</bpmn:incoming>
      <bpmn:incoming>Flow_notify_join</bpmn:incoming>
      <bpmn:outgoing>Flow_join_ciso</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_CisoReview" name="CISO Review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="ciso" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_join_ciso</bpmn:incoming>
      <bpmn:outgoing>Flow_ciso_restore</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_Restore" name="Restore Services">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="restore-services" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ciso_restore</bpmn:incoming>
      <bpmn:outgoing>Flow_restore_integrity</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_IntegrityVerify" name="Integrity Verification">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="soc-analyst" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_restore_integrity</bpmn:incoming>
      <bpmn:outgoing>Flow_integrity_report</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_Report" name="Generate Post-Incident Report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generate-report" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_integrity_report</bpmn:incoming>
      <bpmn:outgoing>Flow_report_closure</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_Closure" name="Incident Closure">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="incident-commander" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_report_closure</bpmn:incoming>
      <bpmn:outgoing>Flow_closure_close</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_Close" name="Close Incident">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="close-incident" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_closure_close</bpmn:incoming>
      <bpmn:outgoing>Flow_close_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Closed" name="Closed">
      <bpmn:incoming>Flow_close_end</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="Flow_start_triage" sourceRef="StartEvent_1" targetRef="Task_Triage" />
    <bpmn:sequenceFlow id="Flow_triage_classify" sourceRef="Task_Triage" targetRef="Task_Classify" />
    <bpmn:sequenceFlow id="Flow_classify_record" sourceRef="Task_Classify" targetRef="Task_RecordClass" />
    <bpmn:sequenceFlow id="Flow_record_p4" sourceRef="Task_RecordClass" targetRef="Gateway_P4" />
    <bpmn:sequenceFlow id="Flow_p4_yes" name="P4" sourceRef="Gateway_P4" targetRef="Task_AutoClose">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=severity = "P4"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_autoclose_end" sourceRef="Task_AutoClose" targetRef="End_AutoClosed" />
    <bpmn:sequenceFlow id="Flow_p4_no" name="P1-P3" sourceRef="Gateway_P4" targetRef="Gateway_Split" />
    <bpmn:sequenceFlow id="Flow_split_isolate" sourceRef="Gateway_Split" targetRef="Task_Isolate" />
    <bpmn:sequenceFlow id="Flow_split_evidence" sourceRef="Gateway_Split" targetRef="Task_CollectEvidence" />
    <bpmn:sequenceFlow id="Flow_split_notify" sourceRef="Gateway_Split" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="Flow_isolate_verify" sourceRef="Task_Isolate" targetRef="Task_ContainVerify" />
    <bpmn:sequenceFlow id="Flow_isofail_handle" sourceRef="Boundary_IsolationFailed" targetRef="Task_HandleIsoFail" />
    <bpmn:sequenceFlow id="Flow_handle_verify" sourceRef="Task_HandleIsoFail" targetRef="Task_ContainVerify" />
    <bpmn:sequenceFlow id="Flow_verify_join" sourceRef="Task_ContainVerify" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_evidence_forensic" sourceRef="Task_CollectEvidence" targetRef="Task_ForensicAnalysis" />
    <bpmn:sequenceFlow id="Flow_forensic_join" sourceRef="Task_ForensicAnalysis" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_notify_join" sourceRef="Task_Notify" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_join_ciso" sourceRef="Gateway_Join" targetRef="Task_CisoReview" />
    <bpmn:sequenceFlow id="Flow_ciso_restore" sourceRef="Task_CisoReview" targetRef="Task_Restore" />
    <bpmn:sequenceFlow id="Flow_restore_integrity" sourceRef="Task_Restore" targetRef="Task_IntegrityVerify" />
    <bpmn:sequenceFlow id="Flow_integrity_report" sourceRef="Task_IntegrityVerify" targetRef="Task_Report" />
    <bpmn:sequenceFlow id="Flow_report_closure" sourceRef="Task_Report" targetRef="Task_Closure" />
    <bpmn:sequenceFlow id="Flow_closure_close" sourceRef="Task_Closure" targetRef="Task_Close" />
    <bpmn:sequenceFlow id="Flow_close_end" sourceRef="Task_Close" targetRef="End_Closed" />

  </bpmn:process>
</bpmn:definitions>
